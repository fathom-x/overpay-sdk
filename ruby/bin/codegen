#!/usr/bin/env ruby
# frozen_string_literal: true

# Renders lib/overpay/generated.rb from spec/overpay-v1.json.
#
# Only the parts of the spec that drift are generated: every string enum a
# client branches on (error codes, order statuses, ...) and the table of
# operations. Models and request plumbing are hand-written in the SDK and
# checked against the spec by its tests.
#
#   bin/codegen           # rewrite the file
#   bin/codegen --check   # exit 1 if the file is stale
#
# The SDK's `generated_is_fresh` test fails when it is stale.

require "json"

module Overpay
  module Codegen
    ROOT = File.expand_path("..", __dir__)
    SPEC = File.join(ROOT, "spec/overpay-v1.json")
    OUTPUT = File.join(ROOT, "lib/overpay/generated.rb")

    # [Ruby module name, JSON pointer to a schema with an `enum`, doc comment]
    ENUMS = [
      ["ErrorCode", "/components/schemas/ErrorCode",
       "Machine-readable `code` on an API error. New codes may appear; match on `known?`."],
      ["PaymentStatus", "/components/schemas/PaymentStatus", "An order's `payment_status`."],
      ["FulfillmentStatus", "/components/schemas/FulfillmentStatus",
       "An order's `fulfillment_status`. `delivered`, `failed`, `cancelled` and `rejected` are terminal."],
      ["RejectionReason", "/components/schemas/RejectionReason",
       "Why a seller rejected a paid order (`rejection.reason_code`)."],
      ["PaymentOutcomeStatus", "/components/schemas/PaymentOutcome/properties/status",
       "How paying for a new order with `pay: merchant_credits` went (`payment.status`)."],
      ["RedemptionStatus", "/components/schemas/Redemption/properties/status",
       "How redeeming merchant credits against an order went."],
      ["SpendAuthorizationStatus", "/components/schemas/SpendAuthorization/properties/status",
       "A spend authorization's lifecycle state."],
      ["PricingMode", "/components/schemas/Listing/properties/pricing_mode",
       "`fixed`: the price is the price. `metered`: the price is only the default authorization."],
      ["RefundStatus", "/components/schemas/Order/properties/refund_status",
       "How much of an order's payment came back to the buyer."],
      ["CreditTransactionType", "/components/schemas/MerchantCreditTransaction/properties/type",
       "The direction of a credit-ledger movement."]
    ].freeze

    # Enums that only exist once the marketplace carries them; rendered when
    # the spec has them, so the gem builds against older specs too.
    OPTIONAL_ENUMS = [
      ["ListingType", "/components/schemas/ListingType",
       "How a listing is bought: `fixed_price`, `request_quote` (the seller prices it first) or `service_lease`."]
    ].freeze

    HTTP_METHODS = %w[get put post delete patch].freeze

    module_function

    def spec
      JSON.parse(File.read(SPEC, encoding: "UTF-8"))
    end

    def pointer(spec, path)
      path.delete_prefix("/").split("/").reduce(spec) { |node, key| node.is_a?(Hash) ? node[key] : nil }
    end

    # The full text of generated.rb for `spec`.
    def render(spec)
      out = +"# frozen_string_literal: true\n\n"
      out << "# @generated by bin/codegen from spec/overpay-v1.json. Do not edit.\n"
      out << "# Regenerate: bin/codegen\n\n"
      out << "module Overpay\n"
      enums = ENUMS + OPTIONAL_ENUMS.select { |(_, ptr, _)| pointer(spec, "#{ptr}/enum") }
      enums.each do |name, ptr, doc|
        values = pointer(spec, "#{ptr}/enum") or raise "#{ptr} has no enum"
        out << "  # #{doc}\n"
        out << "  module #{name}\n"
        values.each { |v| out << "    #{constant(v)} = #{v.inspect}\n" }
        out << "\n    ALL = [#{values.map { |v| constant(v) }.join(', ')}].freeze\n"
        if name == "FulfillmentStatus"
          terminal = %w[delivered failed cancelled rejected] & values
          out << "\n    # Statuses after which an order never changes again.\n"
          out << "    TERMINAL = [#{terminal.map { |v| constant(v) }.join(', ')}].freeze\n"
        end
        out << "\n"
        out << "    def self.known?(value)\n      ALL.include?(value)\n    end\n"
        out << "  end\n\n"
      end

      out << "  # One documented API operation.\n"
      out << "  Operation = Data.define(:id, :method, :path, :audience)\n\n"
      out << "  # Every operation in the spec, by operationId.\n"
      out << "  OPERATIONS = {\n"
      rows = []
      spec.fetch("paths").sort.each do |path, item|
        HTTP_METHODS.each do |method|
          op = item[method] or next
          id = op["operationId"] or raise "#{method} #{path} has no operationId"
          audience =
            case op["x-overpay-audience"]
            when "seller" then "seller"
            when "gateway" then "gateway"
            when nil then (op["tags"] || []).include?("Meta") ? "meta" : "buyer"
            else raise "unknown x-overpay-audience #{op['x-overpay-audience']}"
            end
          rows << "    #{id.inspect} => Operation.new(id: #{id.inspect}, method: #{method.upcase.inspect}, " \
                  "path: #{path.inspect}, audience: #{audience.inspect})"
        end
      end
      out << rows.join(",\n") << "\n  }.freeze\n"
      out << "end\n"
    end

    # `authorization_too_low` → `AUTHORIZATION_TOO_LOW`.
    def constant(value)
      value.split(/[^a-zA-Z0-9]+/).reject(&:empty?).map(&:upcase).join("_")
    end
  end
end

if $PROGRAM_NAME == __FILE__
  rendered = Overpay::Codegen.render(Overpay::Codegen.spec)
  if ARGV.include?("--check")
    unless File.exist?(Overpay::Codegen::OUTPUT) && File.read(Overpay::Codegen::OUTPUT) == rendered
      warn "lib/overpay/generated.rb is stale: run bin/codegen"
      exit 1
    end
  else
    File.write(Overpay::Codegen::OUTPUT, rendered)
    puts "wrote #{Overpay::Codegen::OUTPUT}"
  end
end
